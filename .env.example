# Broker: alpaca | schwab
BROKER=alpaca

# --- Alpaca (paper) ---
APCA_API_KEY_ID=your_paper_key_id_here
APCA_API_SECRET_KEY=your_paper_secret_key_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_BASE_URL=https://data.alpaca.markets

# --- Schwab (https://developer.schwab.com) ---
# App must be approved. Callback URL must match your Schwab app exactly.
SCHWAB_API_KEY=your_schwab_app_key_here
SCHWAB_APP_SECRET=your_schwab_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=data/schwab_token.json
# Comma-separated trade_accounts.id values for a 60s read-only transaction sync.
# Empty disables this job; the hourly all-account reconciliation remains active.
SCHWAB_TRADE_SYNC_ACCOUNT_IDS=
# Optional — required if you have multiple linked accounts
# SCHWAB_ACCOUNT_HASH=

# --- AI (optional — or use Settings UI) ---
# Active LLM provider: mock | openai | anthropic | deepseek | openrouter | ollama
# LLM_PROVIDER=mock

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# REFLECTION_INTERVAL_SECONDS=86400

# Deep research web search (optional — or Settings → Research)
# SEARXNG_URL=http://localhost:8080
# Self-hosted Firecrawl — renders JS and returns clean markdown, used by
# fetch_url to READ pages found by search. Unset = plain httpx reader.
# FIRECRAWL_URL=http://127.0.0.1:3002

# --- Push notifications (optional) ---
# PUSH_ENABLED=1
# PUSH_PROVIDER=apns
# APNS_USE_SANDBOX=1
# Sandbox is the default — dev builds need it. Set APNS_USE_SANDBOX=0 for
# TestFlight/App Store production builds or pushes will not arrive.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_KEY_PATH=data/apns_key.p8

# Backend poll interval for account/positions (seconds, min 5)
# POLL_INTERVAL_SECONDS=20

# --- API security (recommended for local use) ---
# Shared secret between FastAPI and the Next.js frontend.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_TOKEN=
# Admin-only token for risk-control changes (trading limits, kill-switch disarm).
# Generate separately from API_TOKEN; required before PUT /api/settings trading.* works.
# API_ADMIN_TOKEN=
# Phone-approval pin: once your phone shows "Enrolled" under Settings → Approval device,
# set this to 1 so a fresh/restored trading.db can never reopen shared-token approvals.
# ⚠️ Set it BEFORE enrolling and the only remaining approval path is the admin token.
# APPROVAL_REQUIRE_DEVICE=1
# FRONTEND_ORIGIN=http://localhost:3001
# BIND_HOST=127.0.0.1

# Fusion layer (episodes/dots/radar). OFF by default since 2026-08-17 while the
# attention list replaces it (References/ATTENTION_JOIN_DESIGN_2026-08-17.md).
# FUSION_ENABLED=0
