# Broker: alpaca | schwab
BROKER=alpaca

# --- Alpaca (paper) ---
APCA_API_KEY_ID=your_paper_key_id_here
APCA_API_SECRET_KEY=your_paper_secret_key_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_BASE_URL=https://data.alpaca.markets

# --- Schwab (https://developer.schwab.com) ---
# App must be approved. Callback URL must match your Schwab app exactly.
SCHWAB_API_KEY=your_schwab_app_key_here
SCHWAB_APP_SECRET=your_schwab_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=data/schwab_token.json
# Optional — required if you have multiple linked accounts
# SCHWAB_ACCOUNT_HASH=

# --- AI (optional — or use Settings UI) ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Backend poll interval for account/positions (seconds, min 5)
# POLL_INTERVAL_SECONDS=20
