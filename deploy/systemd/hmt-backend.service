[Unit]
Description=help_me_trade backend (FastAPI/uvicorn)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=mbelli
WorkingDirectory=/home/mbelli/dev/help_me_trade
# App loads .env itself via python-dotenv; WorkingDirectory must be the repo root.
ExecStart=/home/mbelli/dev/help_me_trade/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
