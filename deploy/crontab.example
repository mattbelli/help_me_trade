# Example crontab lines for help_me_trade on serv.
# Apply manually on the server (`crontab -e`); these are not installed automatically.
#
# Paths assume repo at /home/mbelli/dev/help_me_trade and uv/venv at .venv/bin/python.

# Nightly SQLite backup (see deploy/backup-db.sh)
0 3 * * * /home/mbelli/dev/help_me_trade/deploy/backup-db.sh >> /home/mbelli/dev/help_me_trade/data/backup.log 2>&1

# Daily Schwab OAuth re-mint — skips when token is <5 days old (--skip-if-fresh default).
# xvfb-run + SCHWAB_REAUTH_HEADED=1 match the working serv setup (headless Playwright needs a display).
0 6 * * * cd /home/mbelli/dev/help_me_trade && SCHWAB_REAUTH_HEADED=1 /usr/bin/xvfb-run -a /home/mbelli/dev/help_me_trade/.venv/bin/python -m scripts.schwab_reauth >> /home/mbelli/dev/help_me_trade/data/reauth.log 2>&1

# Post-close options-chain sampler — the forward arm of the IV corpus (the DoltHub
# snapshot is frozen at 2026-07-17 and cannot be extended). 20:50 UTC = 16:50 EDT,
# after the tape settles; the script gates on the ET trading calendar itself, so the
# weekday range only avoids pointless wakeups. Drifts an hour in EST like the other
# ET-afternoon entries. Re-running a session replaces its rows rather than duplicating.
50 20 * * 1-5 cd /home/mbelli/dev/help_me_trade && [ -f tools/options_chain_sampler.py ] && /home/mbelli/dev/help_me_trade/.venv/bin/python tools/options_chain_sampler.py >> /home/mbelli/dev/help_me_trade/data/research/options_sampler.log 2>&1

# Abnormality scanner nightly: 5-min + daily bar stores, baselines, outcome grades.
# 21:30 UTC = 17:30 EDT (after the cash close AND after the 17:05/17:20 book packs —
# those packs read live fires from the collector, not this job). Script is calendar-gated
# via --since-last. Dead-man on failure.
30 21 * * 1-5 NTFY_TOPIC=hmt-deadman-0033ce1c5edb753f9932 /home/mbelli/dev/help_me_trade/tools/abnormality_nightly.sh >> /home/mbelli/dev/help_me_trade/data/abnormality_nightly.log 2>&1
